# ── GitHub persistence ────────────────────────────────────────────────────────
# Create a Personal Access Token at https://github.com/settings/tokens
# Scopes needed: repo (for a private repo) OR public_repo (for a public repo)
#
# GITHUB_REPO: "owner/repo" of the repo that stores the state file.
#   Can be this same repo, or a dedicated private data repo.
#   Example: "tanlt227/ahma-rotation"
#
# GITHUB_PATH: path to the JSON file inside that repo.
#   Optional — defaults to "data/calendar-data.json" if not set.
#
GITHUB_TOKEN="github_pat_YOUR_FINE_GRAINED_TOKEN_HERE"
GITHUB_REPO="tanlt227/ahma-rotation"
# GITHUB_PATH="data/calendar-data.json"   # optional, uncomment to override

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Required for the chatbot, translation, and Telegram bot.
# Free tier at https://console.groq.com — create an API key there.
# Uses llama-3.3-70b-versatile model.
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Token from @BotFather on Telegram.
# Set the webhook to: https://YOUR_DOMAIN/telegram/webhook
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# ── App URL (Optional) ────────────────────────────────────────────────────────
# The public URL of this deployment (e.g. https://your-app.vercel.app).
# Optional: used for client sharing. Telegram bot operates fully serverlessly without this.
APP_URL="https://your-app.vercel.app"
